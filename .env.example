# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=            # embeddings only (text-embedding-3-small)
DATABASE_URL=postgresql://docchat:docchat@localhost:5432/docchat
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=150
RETRIEVAL_K=6
# RRF score floor below which a hit is dropped. Leave it unset: the app then
# derives it as 1/(60 + RETRIEVAL_K), the score of the last hit the pool can
# return. Setting it by hand couples it to RETRIEVAL_K by accident - 0.015 is
# right at K=6 and silently deletes every rank-7 hit at K=7 (decision 18).
# GROUNDING_MIN_SCORE=
